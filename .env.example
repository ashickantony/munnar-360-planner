# Copy to .env.local to enable optional trial features.
# Everything works without these — the enquiry form falls back to logging + WhatsApp.

# Optional: transactional email for enquiries via Resend (https://resend.com).
# If unset, the enquiry route validates and logs the lead but skips email.
# RESEND_API_KEY=re_xxxxxxxx
# ENQUIRY_TO=hello@munnar360.example
# ENQUIRY_FROM="Munnar 360 <onboarding@resend.dev>"
