# Copy to .env.local for local email delivery, or set these in the Vercel project.
# Configure all three values before accepting enquiries through the form.

# Resend transactional email (https://resend.com); verify the sender domain first.
RESEND_API_KEY=re_xxxxxxxx
ENQUIRY_TO=hello@your-domain.example
ENQUIRY_FROM="Munnar 360 Planner <enquiries@your-domain.example>"

# Used for canonical metadata, sitemap.xml, and robots.txt.
NEXT_PUBLIC_SITE_URL=https://munnar-360-planner.vercel.app
